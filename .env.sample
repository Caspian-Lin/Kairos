# WSL native PostgreSQL. Replace the password with its URL-encoded value.
KAIROS_PG_DSN='postgresql://kairos:REPLACE_POSTGRES_PASSWORD@/kairos?host=/var/run/postgresql'

# Use this same token in the NapCat reverse WebSocket client.
KAIROS_ONEBOT_ACCESS_TOKEN='REPLACE_ONEBOT_TOKEN'

# The example Bot uses Gemini 3.5 Flash-Lite via Google AI Studio.
GEMINI_API_KEY='REPLACE_GEMINI_API_KEY'

# Set the credential referenced by each enabled Bot. Variable names can differ by Bot.
# OPENAI_API_KEY='REPLACE_OPENAI_API_KEY'
# BOT_2_OPENAI_API_KEY='REPLACE_BOT_2_OPENAI_API_KEY'
# ANTHROPIC_API_KEY='REPLACE_ANTHROPIC_API_KEY'
# OPENCODE_GO_API_KEY='REPLACE_OPENCODE_GO_API_KEY'
# CUSTOM_LLM_API_KEY='REPLACE_CUSTOM_LLM_API_KEY'

# Enabled Bot IDs from config/bots/<id>.yaml, separated by commas.
KAIROS_ENABLED_BOTS=1
